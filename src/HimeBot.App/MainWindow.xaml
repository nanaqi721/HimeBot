<Window x:Class="HimeBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HimeBot.App"
        mc:Ignorable="d"
        Title="HimeBot" 
        Height="240" 
        Width="640">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="DMM 游戏快捷方式"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1"
      Margin="0,8,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Margin="0,0,8,0"
                     IsReadOnly="True"
                     Text="{Binding SelectedLaunchTargetPath, Mode=OneWay}" />

            <Button Grid.Column="1"
                    Padding="16,4"
                    Content="选择 DMM 快捷方式..."
                    Command="{Binding SelectLaunchTargetCommand}" />
        </Grid>

        <Button Grid.Row="2"
        HorizontalAlignment="Right"
        Padding="16,6"
        Content="启动游戏"
        Command="{Binding LaunchGameCommand}" />

        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

    </Grid>
    
</Window>
