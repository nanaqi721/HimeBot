<Window x:Class="HimeBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HimeBot.App"
        mc:Ignorable="d"
        Title="HimeBot"
        Height="430"
        Width="640">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="DMM 游戏快捷方式"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1"
      Margin="0,8,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Margin="0,0,8,0"
                     IsReadOnly="True"
                     Text="{Binding SelectedLaunchTargetPath, Mode=OneWay}" />

            <Button Grid.Column="1"
                    Padding="16,4"
                    Content="选择 DMM 快捷方式..."
                    Command="{Binding SelectLaunchTargetCommand}" />
        </Grid>

        <StackPanel Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button Margin="0,0,8,0"
            Padding="16,6"
            Content="启动游戏"
            Command="{Binding LaunchGameCommand}" />

            <Button Margin="0,0,8,0"
            Padding="16,6"
            Content="查找游戏窗口"
            Command="{Binding FindGameWindowCommand}" />

            <Button Margin="0,0,8,0"
            Padding="16,6"
            Content="保存客户区截图"
            Command="{Binding CaptureGameScreenshotCommand}" />

            <Button Margin="0,0,8,0"
            Padding="16,6"
            Content="测试移动鼠标"
            Command="{Binding TestMoveCursorCommand}" />

            <Button Padding="16,6"
            Content="测试鼠标点击"
            Command="{Binding TestClickCursorCommand}" />

        </StackPanel>

        <StackPanel Grid.Row="3"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button Margin="0,0,8,0"
                    Padding="16,6"
                    Content="生成灰度图"
                    Command="{Binding CreateGrayscaleCopyCommand}" />

            <Button Margin="0,0,8,0"
                    Padding="16,6"
                    Content="生成二值图"
                    Command="{Binding CreateBinaryCopyCommand}" />

            <Button Margin="0,0,8,0"
                    Padding="16,6"
                    Content="裁剪资源数字"
                    Command="{Binding CreateOcrRegionCopyCommand}" />

            <Button Padding="16,6"
                    Content="识别资源文字"
                    Command="{Binding RecognizeOcrRegionCommand}" />

        </StackPanel>

        <StackPanel Grid.Row="4"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button Margin="0,0,8,0"
            Padding="16,6"
            Content="设置游戏置顶"
            Command="{Binding SetGameWindowTopmostCommand}" />

            <Button Padding="16,6"
            Content="取消游戏置顶"
            Command="{Binding RemoveGameWindowTopmostCommand}" />

        </StackPanel>

        <StackPanel Grid.Row="5"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <TextBlock Margin="0,0,8,0"
               VerticalAlignment="Center"
               Text="客户区大小" />

            <ComboBox Width="160"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding ClientSizeOptions}"
                      SelectedItem="{Binding SelectedClientSizeOption, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />

            <Button Padding="16,6"
            Content="设置标准客户区大小"
            Command="{Binding SetGameWindowClientSizeCommand}" />

        </StackPanel>

        <TextBlock Grid.Row="6"
                   Margin="0,16,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

    </Grid>

</Window>
